{
  "openapi": "3.0.3",
  "info": {
    "title": "Sandbox REST API",
    "description": "Sandbox REST API Docs",
    "version": "23.1.1"
  },
  "servers": [
    {
      "url": "http://localhost:8083",
      "description": "Локальный сервер разработки"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CreateLocationRequest": {
        "type": "object",
        "required": ["id", "name", "address", "workers"],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "workers": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "Location": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "workers": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/location": {
      "post": {
        "summary": "Создание новой локации",
        "tags": ["Location"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLocationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Успешное создание локации",
            "content": {
              "application/vnd.location.v1+json": {
                "schema": {
                  "$ref": "#/components/schemas/Location"
                }
              }
            }
          },
          "400": {
            "description": "Невалидные данные запроса"
          },
          "401": {
            "description": "Требуется авторизация"
          }
        }
      }
    }
  }
}